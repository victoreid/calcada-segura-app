#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl

write_files:
  - path: /opt/calcada/docker-compose.prod.yml
    encoding: b64
    content: ${compose_b64}
    permissions: "0644"
  - path: /opt/calcada/Caddyfile
    encoding: b64
    content: ${caddy_b64}
    permissions: "0644"
  - path: /opt/calcada/.env
    encoding: b64
    content: ${env_b64}
    permissions: "0600"
  - path: /opt/calcada/deploy.sh
    encoding: b64
    content: ${deploy_b64}
    permissions: "0755"
  - path: /etc/systemd/system/calcada-deploy.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Calcada Segura - puxa a imagem nova do GHCR e atualiza a API
      After=docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      ExecStart=/opt/calcada/deploy.sh
  - path: /etc/systemd/system/calcada-deploy.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Deploy automatico da Calcada Segura a cada minuto

      [Timer]
      OnBootSec=30s
      OnUnitActiveSec=60s

      [Install]
      WantedBy=timers.target

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  - HASH=$(docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext '${metrics_password}') && sed -i "s|__METRICS_HASH__|$HASH|" /opt/calcada/Caddyfile
  - systemctl daemon-reload
  - systemctl enable --now calcada-deploy.timer
